FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .

# CPU-only torch — the default PyPI wheel pulls CUDA deps that aren't needed
# for embedding inference and roughly 10x the image size.
RUN pip install --no-cache-dir torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-api.txt

COPY api.py schemas.py graphdb_client.py gics.py validation.py parse_extraction.py react_agent.py ./

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
