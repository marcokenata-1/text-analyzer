FROM python:3.12-slim

WORKDIR /app

COPY requirements-knowledge-api.txt .

# CPU-only torch — the default PyPI wheel pulls CUDA deps that aren't needed
# for embedding inference and roughly 10x the image size.
RUN pip install --no-cache-dir torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-knowledge-api.txt

COPY knowledge_api.py d_20230318.py ./

EXPOSE 8000

CMD ["uvicorn", "knowledge_api:app", "--host", "0.0.0.0", "--port", "8000"]
