#!/bin/bash
#PBS -N ifrs_mapper_v8
#PBS -q csegpu12
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_model=H200
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m abe
#PBS -M z5603945@ad.unsw.edu.au

echo "================================================"
echo "Job started:  $(date)"
echo "Node:         $(hostname)"
echo "GPU:          $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null)"
echo "VRAM:         $(nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null)"
echo "================================================"

module load python/3.11.3
source ~/thesis_env/bin/activate
cd ~/thesis

export HF_HOME=/srv/scratch/z5603945/hf_cache
export TRANSFORMERS_CACHE=/srv/scratch/z5603945/hf_cache
export HF_DATASETS_CACHE=/srv/scratch/z5603945/hf_cache

echo "HF cache: $HF_HOME"
df -h /srv/scratch/z5603945

python three_stage_mapper_v8.py

echo "================================================"
echo "Job finished: $(date)"
echo "================================================"
